node_modules
dist
.env
.env.local
.env.*.local
.vite
.DS_Store
*.log
.claude
workbook-source/*
!workbook-source/.gitkeep

# Local-only: contains a plaintext shared password — keep out of git history.
supabase/reset_super_trainer_passwords.sql
# Stray source-data spreadsheets dropped into supabase/ (belongs in workbook-source/).
supabase/*.xlsx

# Local-only by standard practice: docs and SQL stay on the laptop, never pushed.
# (SQL is applied by hand in the Supabase SQL Editor; .md docs are a local record.)
# Note: files already tracked before this rule are not auto-untracked.
*.md
*.sql
